KOMBAT_RUNTIME_ROLE={{ and_chain_runtime_role | default('validator') }}
KOMBAT_RPC_BIND=0.0.0.0:{{ and_chain_validator_rpc_port }}
KOMBAT_CHAIN_ID={{ and_chain_chain_id }}
KOMBAT_STATE_BACKEND={{ and_chain_state_backend | default('redb') }}
KOMBAT_STATE_DIR={{ and_chain_state_dir }}
KOMBAT_MEMPOOL_FSYNC={{ and_chain_mempool_fsync | default('sync') }}
KOMBAT_MEMPOOL_GROUP_COMMIT_MS={{ and_chain_mempool_group_commit_ms | default(10) }}
KOMBAT_GENESIS_TIMESTAMP_MS={{ and_chain_genesis_timestamp_ms }}
{% if and_chain_validator_network_topology_enabled | default(true) | bool %}
KOMBAT_VALIDATOR_SET_PATH={{ and_chain_config_dir }}/validator-set.toml
{% endif %}
KOMBAT_VALIDATOR_ID_HEX={{ validator_id_hex }}
KOMBAT_CONSENSUS_SIGNING_KEY_HEX={{ consensus_signing_key_hex }}
KOMBAT_OPERATOR_TOKEN={{ and_chain_operator_token | to_json }}
KOMBAT_PEER_RELAY_TOKEN={{ lookup('env', 'KOMBAT_PEER_RELAY_TOKEN') | to_json }}
KOMBAT_LEGACY_DELEGATION_BRIDGE_ENABLED={{ and_chain_legacy_delegation_bridge_enabled | default(false) | bool | ternary('1', '0') }}
KOMBAT_PUBLIC_RPC_URL={{ public_rpc_url }}
KOMBAT_PEER_TRANSPORT_ENABLED={{ and_chain_peer_transport_enabled | default(true) | bool | ternary('1', '0') }}
KOMBAT_PEER_TRANSPORT_KEEPALIVE_ENABLED={{ and_chain_peer_transport_keepalive_enabled | default(true) | bool | ternary('1', '0') }}
KOMBAT_NETWORK_SUBMIT_FORWARDING_ENABLED={{ and_chain_network_submit_forwarding_enabled | default(false) | bool | ternary('1', '0') }}
KOMBAT_LOCAL_BRIDGE_MUTATIONS_ENABLED={{ and_chain_local_bridge_mutations_enabled | default(false) | bool | ternary('1', '0') }}
KOMBAT_BASE_TIMEOUT_MS={{ and_chain_base_timeout_ms }}
KOMBAT_MAX_TIMEOUT_MS={{ and_chain_max_timeout_ms }}
KOMBAT_MAX_TIMEOUT_EXPONENT={{ and_chain_max_timeout_exponent }}
KOMBAT_MAX_CLOCK_SKEW_MS={{ and_chain_max_clock_skew_ms }}
{% if and_chain_auto_network_round_enabled | default(true) | bool %}
KOMBAT_DEV_AUTO_NETWORK_ROUND_INTERVAL_MS={{ and_chain_auto_network_round_interval_ms }}
KOMBAT_DEV_AUTO_NETWORK_DRIVE_INTERVAL_MS={{ and_chain_auto_network_drive_interval_ms }}
KOMBAT_DEV_AUTO_NETWORK_MAX_ITEMS={{ and_chain_auto_network_max_items }}
{% endif %}
KOMBAT_CONSENSUS=mahi
KOMBAT_MAHI_COMMIT_RULE={{ and_chain_mahi_commit_rule }}
KOMBAT_MAHI_MULTILEADER={{ and_chain_mahi_multileader }}
KOMBAT_MAHI_PAYLOAD_SHARDING={{ and_chain_mahi_payload_sharding | default('1') }}
KOMBAT_MAHI_LEGACY_EXEC={{ and_chain_mahi_legacy_exec | default('0') }}
KOMBAT_MAHI_ALLOW_IDLE_EMPTY_ROUNDS={{ and_chain_mahi_allow_idle_empty_rounds }}
KOMBAT_MAHI_OBSERVER_ASYNC_RELAY={{ and_chain_mahi_observer_async_relay }}
KOMBAT_MAHI_ASYNC_BLOCK_BROADCAST={{ and_chain_mahi_async_block_broadcast }}
KOMBAT_MAHI_MERGED_EXECUTION_BATCH={{ and_chain_mahi_merged_execution_batch }}
KOMBAT_MAHI_OWNER_RELAY_REDUNDANCY={{ and_chain_mahi_owner_relay_redundancy }}
KOMBAT_MAHI_OWNER_RELAY_LAG_ROUNDS={{ and_chain_mahi_owner_relay_lag_rounds }}
{% set faucet_redis_url = and_chain_resolved_faucet_redis_url | default(and_chain_faucet_redis_url) %}
{% if faucet_redis_url | length > 0 %}
KOMBAT_FAUCET_REDIS_URL={{ faucet_redis_url }}
KOMBAT_FAUCET_ADDRESS_COOLDOWN_SECS={{ and_chain_faucet_address_cooldown_secs }}
KOMBAT_FAUCET_IP_WINDOW_SECS={{ and_chain_faucet_ip_window_secs }}
KOMBAT_FAUCET_IP_MAX_CLAIMS={{ and_chain_faucet_ip_max_claims }}
KOMBAT_FAUCET_GLOBAL_WINDOW_SECS={{ and_chain_faucet_global_window_secs }}
KOMBAT_FAUCET_GLOBAL_MAX_CLAIMS={{ and_chain_faucet_global_max_claims }}
{% endif %}
{% if and_chain_validator_bootstrap_rpc_url is defined and (and_chain_validator_bootstrap_rpc_url | length > 0) %}
KOMBAT_BOOTSTRAP_RPC_URL={{ and_chain_validator_bootstrap_rpc_url }}
KOMBAT_BOOTSTRAP_BEARER_TOKEN={{ and_chain_operator_token | to_json }}
{% elif inventory_hostname != 'validator-1' and (and_chain_validator_remote_bootstrap_enabled | default(false) | bool) %}
KOMBAT_BOOTSTRAP_RPC_URL={{ hostvars['validator-1'].public_rpc_url }}
KOMBAT_BOOTSTRAP_BEARER_TOKEN={{ and_chain_operator_token | to_json }}
{% else %}
KOMBAT_BOOTSTRAP_EMPTY_BLOCK_TIMESTAMP_MS={{ and_chain_bootstrap_empty_block_timestamp_ms }}
{% endif %}
