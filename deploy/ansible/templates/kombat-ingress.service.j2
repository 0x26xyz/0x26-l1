[Unit]
Description=Kombat Chain ingress {{ ingress.name }}
After=network-online.target {{ validator_service_name }}.service
Wants=network-online.target

[Service]
Type=simple
User={{ and_chain_user }}
Group={{ and_chain_group }}
WorkingDirectory={{ and_chain_install_root }}
EnvironmentFile={{ and_chain_config_dir }}/{{ ingress.name }}.env
ExecStart={{ and_chain_install_root }}/bin/kombat_chain
Restart=always
RestartSec=5
LimitNOFILE=1048576
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths={{ and_chain_state_dir }}

[Install]
WantedBy=multi-user.target
